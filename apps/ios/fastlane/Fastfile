default_platform(:ios)

platform :ios do
  desc "Build and upload a TestFlight beta. Signing happens on a Mac."
  lane :beta do
    team = ENV.fetch("APPLE_TEAM_ID", "TEAMIDPLACEHOLDER")
    UI.user_error!("Set APPLE_TEAM_ID. TEAMIDPLACEHOLDER is not a real team.") if team == "TEAMIDPLACEHOLDER"
    %w[ASC_KEY_ID ASC_ISSUER_ID ASC_PRIVATE_KEY_BASE64].each do |name|
      UI.user_error!("Set #{name}.") if ENV[name].to_s.empty?
    end

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_PRIVATE_KEY_BASE64"),
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )

    build_app(
      project: "RistonchiStaff.xcodeproj",
      scheme: "RistonchiStaff",
      export_method: "app-store",
      clean: true,
      xcargs: "DEVELOPMENT_TEAM='#{team}'"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
