# Copy to .env in the repo root for the Node dev server:
#   cp .env.example .env
# The app runs with these defaults if the file is absent. Never commit .env.

# Product name is a code constant (packages/shared). This echo is documentation only.
# APP_NAME=Ristonchi Staff

PORT=8787
WEB_ORIGIN=http://localhost:5173

# mock (default) uses the demo staff below. platform calls Norberto. See NORBERT.md.
AUTH_MODE=mock
PLATFORM_AUTH_URL=https://api.ristonchi.com
# Shared password for the four demo accounts. Not a real credential.
MOCK_STAFF_PASSWORD=ristonchi-demo

# mock (default) serves fictional weddings. mcp calls the hosted MCP server.
PLATFORM_MODE=mock
PLATFORM_MCP_URL=https://api.ristonchi.com/mcp

# mock (default) needs no key and is enough to try the app.
# openai uses an OpenAI-compatible chat completions API.
# azure uses Azure OpenAI.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# iOS / TestFlight. Used on a Mac by Fastlane. Never commit the key.
APPLE_TEAM_ID=TEAMIDPLACEHOLDER
ASC_KEY_ID=
ASC_ISSUER_ID=
# Base64 of the App Store Connect API private key (.p8).
ASC_PRIVATE_KEY_BASE64=
